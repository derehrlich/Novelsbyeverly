# Von https://dev.twitch.tv/console/apps (OAuth Redirect URL: https://DEINE-SEITE.netlify.app/api/auth/callback)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# beliebiger Zufallstext, 10 bis 100 Zeichen (signiert die Twitch-Webhooks)
EVENTSUB_SECRET=
# Passwort für den Admin-Bereich
ADMIN_PASSWORD=
# optional: Schlüssel für die Schnittstellen /api/words (Papyrus) und /api/musik (Hilfsprogramm, siehe scripts/pc-helfer.mjs)
INGEST_TOKEN=
# optional, nur bei eigener Domain
SITE_URL=
