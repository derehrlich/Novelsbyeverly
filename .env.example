# Kopiere diese Datei nach <Datenordner>/novelsbyeverly.env (CasaOS: /DATA/AppData/novelsbyeverly/data/novelsbyeverly.env)
# und trage deine Werte ein. Diese Datei gehört nie in Git, Chats oder Screenshots.

# Passwort für den Admin-Bereich (lang wählen)
ADMIN_PASSWORD=
# Client-ID der Twitch-App (https://dev.twitch.tv/console/apps, Client Type: Public)
TWITCH_CLIENT_ID=
# nur bei Client Type „Confidential“
TWITCH_CLIENT_SECRET=
# optional: Schlüssel für die Schnittstellen /api/words (Papyrus) und /api/musik (siehe scripts/pc-helfer.mjs)
INGEST_TOKEN=
# optional: Port (Standard 8888)
PORT=8888
