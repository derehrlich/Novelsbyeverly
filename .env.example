# Alle Werte stehen auch in docker-compose.yml. Für den Start ohne Docker: .env anlegen und mit `node --env-file=.env server/index.mjs` starten.
# Von https://dev.twitch.tv/console/apps (Client Type: Public, OAuth Redirect URL: http://localhost)
TWITCH_CLIENT_ID=
# nur bei Client Type „Confidential“
TWITCH_CLIENT_SECRET=
# Passwort für den Admin-Bereich
ADMIN_PASSWORD=
# optional: Schlüssel für die Schnittstellen /api/words (Papyrus) und /api/musik (siehe scripts/pc-helfer.mjs)
INGEST_TOKEN=
# optional: Port (Standard 8888) und Datenordner (Standard ./data bzw. /data im Container)
PORT=8888
DATA_DIR=./data
